# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Large / regenerable artifacts
# (comments must be on their own line -- git has no inline comments)
# raw HuggingFace download (~1.3GB, regenerable)
data/apps_raw/
# generated candidates/problems (hundreds of MB; regenerable via the seeded pipeline)
data/problems/*.jsonl
# cached model calls can get large; keep local
models/cache/
# stray redirect output
output.txt
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude / assistant files (used for development; kept local, not committed)
CLAUDE.md
CLAUDE.local.md
CLAUDE.md.txt
.claude/

# Keep these tracked even though the dirs above are ignored:
!results/.gitkeep
!data/.gitkeep
